# Copie este arquivo para ".env" (dev local) ou cole cada valor nas
# variáveis de ambiente do seu provedor de hospedagem (produção).

# Obrigatório
NODE_ENV=production
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco
JWT_SECRET=troque-por-um-texto-aleatorio-longo

# Porta HTTP (a maioria dos provedores define isso automaticamente)
PORT=3000

# Armazenamento de arquivos (XML das notas fiscais).
# Funciona com qualquer serviço compatível com S3: AWS S3, Cloudflare R2,
# MinIO, etc. Sem essas variáveis, o envio/visualização de XML não funciona.
S3_BUCKET=nome-do-bucket
S3_REGION=auto
S3_ACCESS_KEY_ID=xxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxx
# Necessário apenas para provedores que não sejam a AWS (ex.: Cloudflare R2).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true

# URL pública do sistema. Usada nos links do e-mail de redefinição de senha.
APP_URL=https://seu-app.up.railway.app

# Envio de e-mail (opcional): avisos de agendamento, de acesso liberado e o
# link de "esqueci minha senha". Sem nenhum dos dois caminhos abaixo, o sistema
# funciona igual, só não manda e-mail nenhum.
#
# Caminho 1 — a caixa da própria empresa (Outlook/Microsoft 365, Google
# Workspace). Não precisa mexer no DNS do domínio. A senha é a "senha de
# aplicativo" da conta, nunca a senha pessoal, e o SMTP autenticado precisa
# estar liberado para essa caixa.
#   Microsoft 365: smtp.office365.com, porta 587
#   Google Workspace: smtp.gmail.com, porta 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Caminho 2 — Resend, com o domínio verificado lá (exige DNS).
RESEND_API_KEY=

# Quem assina a mensagem. No SMTP, precisa ser a própria caixa autenticada —
# em branco, o sistema usa o SMTP_USER.
MAIL_FROM=

# Opcionais (login social via Manus OAuth). Deixe em branco se não for usar.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Liga as contas de teste (login "admin", que abre qualquer perfil) num ambiente
# de produção. Vazia, elas ficam desligadas — que é o certo para o sistema no
# ar. Definida, precisa ter 12 caracteres ou mais, e passa a ser a senha delas:
# "admin" deixa de funcionar.
SENHA_CONTAS_TESTE=
